$e = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
/**
 * Translated and escaped text. %1, %2... are replaced by the given HTML fragments (not escaped),
 * so markup such as <code> stays out of the translation files.
 */
$t = static function (string $text, string ...$html) use ($e): string {
    $pairs = [];
    foreach ($html as $index => $fragment) {
        $pairs['%' . ($index + 1)] = $fragment;
    }
    return strtr($e(__($text)), $pairs);
};
$d = $defaults;
// Inlined: the wizard answers from Magento's index.php before Magento boots, so there is no static file URL.
$logo = 'data:image/png;base64,' . base64_encode((string) file_get_contents(__DIR__ . '/magento-logo.png'));
