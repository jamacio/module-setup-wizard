<script type="application/json" id="ctx"><?= json_encode(['view' => $view, 'job' => $job, 'text' => $scriptText], JSON_HEX_TAG | JSON_HEX_AMP | JSON_UNESCAPED_UNICODE) ?></script>
<script>
(() => {
    'use strict';
    const ctx = JSON.parse(document.getElementById('ctx').textContent);
    const __ = (text, ...args) => args.reduce(
        (out, arg, index) => out.split(`%${index + 1}`).join(arg),
        ctx.text[text] ?? text
    );
    const $ = (selector, root = document) => root.querySelector(selector);
    const el = (tag, className, text) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
    };

    async function post(action, form) {
        const data = new FormData(form);
        data.set('action', action);
        const response = await fetch(location.pathname + location.search, { method: 'POST', body: data, credentials: 'same-origin' });
        try {
            return await response.json();
        } catch (e) {
            return { ok: false, message: __('Unexpected server response (HTTP %1).', response.status) };
        }
    }

    if (ctx.view === 'form') {
        const form = $('#wizard');
        const banner = $('#form-banner');

        const sync = () => {
            const mode = form.elements.mode.value;
            document.body.dataset.mode = mode;
            $('#admin-fields').hidden = mode === 'existing' && !$('#admin-enabled').checked;
            $('#redis-fields').hidden = !$('#redis-enabled').checked;
            const repoKeys = $('#repo-keys');
            if (repoKeys) repoKeys.hidden = !$('#sample-data').checked;
            $('#search-fields').style.opacity = mode === 'existing' && !$('#search-write').checked ? '.5' : '';
            const noSearchServer = form.elements['search[engine]'].value === 'mysql_basic';
            form.querySelectorAll('[data-search-server]').forEach(field => { field.hidden = noSearchServer; });
            $('#search-mysql-note').hidden = !noSearchServer;
            const base = form.elements.base_url.value.replace(/\/?$/, '/');
            $('#admin-preview').textContent = base + (form.elements.backend_frontname.value || 'admin') + '/';
        };
        form.addEventListener('input', sync);
        form.addEventListener('change', sync);
        sync();

        const clearErrors = () => {
            banner.hidden = true;
            form.querySelectorAll('.field.invalid').forEach(field => field.classList.remove('invalid'));
        };
        const showErrors = (result) => {
            banner.textContent = result.message || __('Could not continue.');
            banner.hidden = false;
            let first = null;
            Object.entries(result.errors || {}).forEach(([key, message]) => {
                const field = form.querySelector(`[data-field="${key}"]`);
                if (!field) return;
                field.classList.add('invalid');
                $('small.error', field).textContent = message;
                first = first || field;
            });
            (first || banner).scrollIntoView({ behavior: 'smooth', block: 'center' });
        };

        $('#test-btn').addEventListener('click', async (event) => {
            const button = event.currentTarget;
            const list = $('#test-results');
            button.disabled = true;
            button.textContent = __('Testing…');
            const result = await post('test', form);
            button.disabled = false;
            button.textContent = __('Test connections');
            list.replaceChildren();
            list.hidden = false;
            if (!result.ok) {
                list.append(row(__('Test'), { ok: false, message: result.message }));
                return;
            }
            const labels = { db: __('Database'), search: __('Search engine'), redis: __('Redis') };
            Object.entries(result.results).forEach(([key, item]) => list.append(row(labels[key], item)));
        });

        const row = (label, item) => {
            const li = el('li');
            const warn = item.ok && item.exists === false;
            li.append(
                el('span', `dot ${item.ok ? (warn ? 'warn' : 'ok') : 'fail'}`, item.ok ? (warn ? '!' : '✓') : '✕'),
                el('span', '', label),
                el('span', 'detail', item.message)
            );
            return li;
        };

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            clearErrors();
            const button = $('#submit-btn');
            button.disabled = true;
            const result = await post('start', form);
            if (result.ok) {
                location.href = `${location.pathname}?job=${encodeURIComponent(result.job)}`;
                return;
            }
            button.disabled = false;
            showErrors(result);
        });
    }

    if (ctx.view === 'job') {
        const id = ctx.job.id;
        const log = $('#log');
        const labels = { queued: __('Queued'), running: __('Running'), success: __('Done'), failed: __('Failed') };
        const icons = { pending: ['pending', ''], running: ['running', ''], success: ['ok', '✓'], failed: ['fail', '✕'] };
        let offset = 0;

        const render = (status) => {
            $('#job-title').textContent = status.meta.mode === 'existing' ? __('Configuring the store') : __('Installing Magento');
            const badge = $('#job-badge');
            badge.className = `badge ${status.state}`;
            badge.textContent = labels[status.state] || status.state;

            const start = status.started_at || status.created_at;
            const end = status.finished_at || Math.floor(Date.now() / 1000);
            const seconds = Math.max(0, end - start);
            $('#job-elapsed').textContent = `${Math.floor(seconds / 60)}min ${String(seconds % 60).padStart(2, '0')}s`;

            $('#job-steps').replaceChildren(...status.steps.map(step => {
                const [cls, glyph] = icons[step.state] || icons.pending;
                const li = el('li');
                li.append(el('span', `dot ${cls}`, glyph), el('span', '', step.label));
                return li;
            }));

            const result = $('#job-result');
            if (status.state === 'success') {
                result.className = 'banner ok';
                result.replaceChildren(el('b', '', __('Done!') + ' '), document.createTextNode(__('The store is live.') + ' '));
                const links = [[status.meta.store_url, __('Open the storefront')], [status.meta.admin_url, __('Open the admin')]];
                links.forEach(([href, text]) => {
                    const a = el('a', '', text);
                    a.href = href;
                    a.style.marginRight = '14px';
                    result.append(a);
                });
                if (status.meta.admin_user) {
                    result.append(el('span', 'sub', __('(user: %1)', status.meta.admin_user)));
                }
                result.hidden = false;
            } else if (status.state === 'failed') {
                result.className = 'banner err';
                result.textContent = status.error || __('The run failed. See the log.');
                result.hidden = false;
            }
        };

        const poll = async () => {
            let status;
            try {
                const response = await fetch(`${location.pathname}?action=status&job=${encodeURIComponent(id)}&offset=${offset}`, { credentials: 'same-origin' });
                status = await response.json();
            } catch (e) {
                setTimeout(poll, 3000);
                return;
            }
            if (!status.ok) {
                $('#job-result').className = 'banner err';
                $('#job-result').textContent = status.message;
                $('#job-result').hidden = false;
                return;
            }
            if (status.log) {
                log.append(document.createTextNode(status.log));
                if ($('#follow').checked) log.scrollTop = log.scrollHeight;
            }
            offset = status.offset;
            render(status);
            if (status.state === 'queued' || status.state === 'running') {
                setTimeout(poll, status.log ? 500 : 1500);
            } else if (status.state === 'success') {
                redirectToStore(status.meta.store_url);
            }
        };

        // After a successful run the wizard URL serves Magento anyway: take the user to the store.
        const redirectToStore = (url) => {
            let seconds = 5;
            const notice = el('span', 'sub', '');
            $('#job-result').append(el('br'), notice);
            const tick = () => {
                if (seconds === 0) {
                    location.replace(url);
                    return;
                }
                notice.textContent = __('Opening the storefront in %1 s…', seconds);
                seconds--;
                setTimeout(tick, 1000);
            };
            tick();
        };
        render(ctx.job);
        poll();
    }
})();
</script>
</body>
</html>
